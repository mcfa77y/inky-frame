from typing import Any

class Response:
    def read(self, *args: Any, **kwargs: Any) -> bytes: ...
    def readinto(self, *args: Any, **kwargs: Any) -> int: ...
    def readline(self, *args: Any, **kwargs: Any) -> bytes: ...
    def close(self) -> None: ...

def urlopen(url: str, *args: Any, **kwargs: Any) -> Response: ...
