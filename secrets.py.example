# secrets.py - Hardware and API configuration
# Copy to secrets.py on the Inky Frame filesystem

# Wi-Fi Credentials
WIFI_SSID = "Your_WiFi_SSID"
WIFI_PASSWORD = "Your_WiFi_Password"

# TRMNL Self-Hosted Server Configuration (BYOD-S / BYOS)
# Set to your self-hosted TRMNL instance (e.g. Terminus, LaraPaper, BYOS Next.js)
TRMNL_BASE_URL = "http://byos.local"

# Device API Key:
# Optional if your self-hosted server auto-provisions devices via /api/setup.
# If auto-provisioning is disabled or using pre-registered tokens, place API key here.
TRMNL_API_KEY = ""

# Device MAC Override:
# Optional. Left empty, the Inky Frame uses its hardware Wi-Fi MAC address.
TRMNL_DEVICE_ID = ""
